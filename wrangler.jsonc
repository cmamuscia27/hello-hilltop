{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hello-hilltop",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "account_id": "c74b4a5d3545b51f59db846c41a52483",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hello-hilltop-db",
      "database_id": "496719ee-16dd-418b-a280-94fc05d11fb1",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 */4 * * *"]
  },
  "routes": [
    { "pattern": "hellohilltop.org", "custom_domain": true },
    { "pattern": "www.hellohilltop.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // Branch previews (npx wrangler preview) must not use the production database.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "hello-hilltop-preview",
        "database_id": "71ea0d4e-8ccd-464c-9946-9545b3def471"
      }
    ]
  }
  // Secrets (not in git): EXPORT_TOKEN, TURNSTILE_SECRET, INSTAGRAM_ACCESS_TOKEN
  // Optional: INSTAGRAM_APP_SECRET, only to exchange a 1-hour Instagram token.
  // Optional public payment links, plain vars or secrets, not committed:
  // SUPPORT_CHECKOUT_URL, SUPPORT_GO_GETTER_URL, SUPPORT_FAMILY_URL,
  // SUPPORT_BUSINESS_URL, SUPPORT_VENMO_URL, SUPPORT_ZEFFY_URL, SUPPORT_PAYPAL_URL
  // Prefer PUT /api/admin/support so a link can change without a deploy.
  // keep_vars preserves dashboard plain-text variables across wrangler deploy.
  // `npx wrangler secret put EXPORT_TOKEN` / `npx wrangler secret put TURNSTILE_SECRET`
  // `npx wrangler secret put INSTAGRAM_ACCESS_TOKEN`
}
